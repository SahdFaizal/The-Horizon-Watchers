import pandas as pd
import pytest

from fh_ml_addon.data import load_science


def test_duplicate_sector_day_is_rejected(tmp_path):
    path = tmp_path / "science.csv"
    pd.DataFrame({
        "date": ["2020-01-01", "2020-01-01"],
        "sector": ["S1", "S1"],
        "m7_C": [0.0, 1.0],
    }).to_csv(path, index=False)
    with pytest.raises(ValueError, match="Duplicate"):
        load_science(path)


def test_missing_m7_c_is_not_silently_zeroed(tmp_path):
    path = tmp_path / "science.csv"
    pd.DataFrame({
        "date": ["2020-01-01", "2020-01-02"],
        "sector": ["S1", "S1"],
        "m7_C": [0.0, None],
    }).to_csv(path, index=False)
    frame = load_science(path)
    assert len(frame) == 2
    assert pd.isna(frame.loc[1, "m7_C"])
